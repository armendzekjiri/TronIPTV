<Window x:Class="TronIPTV.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TronIPTV.ViewModels"
        xmlns:local="clr-namespace:TronIPTV"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="TronIPTV" Icon="/Assets/app.ico" Width="1500" Height="900" MinWidth="1100" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Live channel / episode row -->
        <DataTemplate x:Key="ChannelRow" DataType="{x:Type vm:ChannelItem}">
            <Grid Height="54">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="PlayingBar" Width="3" Height="26" CornerRadius="2" Background="{StaticResource Accent}"
                        HorizontalAlignment="Left" Margin="-6,0,0,0" Visibility="Hidden" />
                <TextBlock x:Name="Number" Text="{Binding NumberText}" Foreground="{StaticResource Subtle}" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Border Grid.Column="1" Width="44" Height="44" CornerRadius="8" Background="{StaticResource Panel2}" HorizontalAlignment="Left">
                    <Grid>
                        <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource Subtle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding LogoUrl, Converter={StaticResource Logo}, ConverterParameter=64}" Stretch="Uniform" Margin="4"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="2,0,6,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Row="1" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Subtle}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding RemainingText}" Foreground="{StaticResource Subtle}" FontSize="11" Margin="8,0,0,0"
                                   Opacity="0.8" VerticalAlignment="Center" />
                    </Grid>
                    <ProgressBar Grid.Row="2" Style="{StaticResource ThinProgress}" Value="{Binding Progress}" Margin="0,5,0,0"
                                 Visibility="{Binding Progress, Converter={StaticResource VisibleWhen}}" />
                </Grid>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Play"
                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                            Foreground="{StaticResource Text}" Visibility="Hidden" />
                    <Button x:Name="StarButton" Style="{StaticResource IconButton}" Content="&#xE734;" ToolTip="Favorite (Ctrl+D)"
                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                            Foreground="{StaticResource Subtle}" Visibility="Hidden" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="PlayButton" Property="Visibility" Value="Visible" />
                    <Setter TargetName="StarButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter TargetName="StarButton" Property="Content" Value="&#xE735;" />
                    <Setter TargetName="StarButton" Property="Foreground" Value="{StaticResource Gold}" />
                    <Setter TargetName="StarButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CanFavorite}" Value="False">
                    <Setter TargetName="StarButton" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource AccentLight}" />
                    <Setter TargetName="Number" Property="Foreground" Value="{StaticResource AccentLight}" />
                    <Setter TargetName="PlayingBar" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Movie / series poster card -->
        <DataTemplate x:Key="PosterCard" DataType="{x:Type vm:ChannelItem}">
            <Border x:Name="Card" Width="{Binding PosterWidth, RelativeSource={RelativeSource AncestorType=Window}}" Margin="7" CornerRadius="10" Background="{StaticResource Panel2}"
                    BorderThickness="2" BorderBrush="Transparent" Cursor="Hand"
                    MouseLeftButtonDown="PosterCard_MouseLeftButtonDown" ToolTip="{Binding Name}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding PosterHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border CornerRadius="8,8,0,0" Background="#1E1618">
                        <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource DisplayFont}" FontSize="48" FontWeight="SemiBold"
                                   Foreground="#4A3438" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="8,8,0,0">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding LogoUrl, Converter={StaticResource Logo}, ConverterParameter=330}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <Border x:Name="HoverShade" CornerRadius="8,8,0,0" Background="#80000000" Visibility="Hidden">
                        <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource AccentGradient}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="HoverGlyph" Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0" />
                        </Border>
                    </Border>
                    <Border Background="#D9000000" CornerRadius="6" Padding="6,2" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Visibility="{Binding RatingText, Converter={StaticResource VisibleWhen}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RatingText}" Foreground="White" FontSize="11.5" FontWeight="SemiBold" Margin="4,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#D9000000" CornerRadius="6" Padding="5,4" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Visibility="{Binding IsFavorite, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="&#xE735;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource Gold}" />
                    </Border>
                    <Border Background="{StaticResource AccentGradient}" CornerRadius="6" Padding="7,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Visibility="{Binding IsPlaying, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="Playing" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="10,8,10,10">
                        <TextBlock x:Name="CardTitle" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   MaxHeight="36" LineHeight="18" LineStackingStrategy="BlockLineHeight" />
                        <TextBlock Text="{Binding Channel.Group}" Foreground="{StaticResource Subtle}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="HoverShade" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource Hover}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSeries}" Value="True">
                    <Setter TargetName="HoverGlyph" Property="Text" Value="&#xE8A9;" />
                    <Setter TargetName="HoverGlyph" Property="Margin" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="CardTitle" Property="Foreground" Value="{StaticResource AccentLight}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="BrowserColumn" Width="800" MinWidth="620" />
            <ColumnDefinition x:Name="SplitterColumn" Width="4" />
            <ColumnDefinition x:Name="PlayerColumn" Width="*" MinWidth="380" />
        </Grid.ColumnDefinitions>

        <!-- ================= Browser: rail | categories | content ================= -->
        <Grid x:Name="Browser">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="256" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <DockPanel Background="{StaticResource Rail}">
                <Image DockPanel.Dock="Top" Source="/Assets/logo.png" Width="48" Height="48" Margin="0,14,0,16"
                       RenderOptions.BitmapScalingMode="HighQuality" ToolTip="{x:Static local:AppInfo.Title}" />
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Style="{StaticResource RailButton}" Tag="&#xE7F4;" Content="Live TV" GroupName="Nav"
                                 IsEnabled="{Binding LiveCount, Converter={StaticResource NonZero}}"
                                 IsChecked="{Binding Tab, Converter={StaticResource EnumEquals}, ConverterParameter=Live}">
                        <RadioButton.ToolTip><TextBlock Text="{Binding LiveCount, StringFormat='{}{0:N0} channels'}" /></RadioButton.ToolTip>
                    </RadioButton>
                    <RadioButton Style="{StaticResource RailButton}" Tag="&#xE8B2;" Content="Movies" GroupName="Nav"
                                 IsEnabled="{Binding MovieCount, Converter={StaticResource NonZero}}"
                                 IsChecked="{Binding Tab, Converter={StaticResource EnumEquals}, ConverterParameter=Movies}">
                        <RadioButton.ToolTip><TextBlock Text="{Binding MovieCount, StringFormat='{}{0:N0} movies'}" /></RadioButton.ToolTip>
                    </RadioButton>
                    <RadioButton Style="{StaticResource RailButton}" Tag="&#xE8A9;" Content="Series" GroupName="Nav"
                                 IsEnabled="{Binding SeriesCount, Converter={StaticResource NonZero}}"
                                 IsChecked="{Binding Tab, Converter={StaticResource EnumEquals}, ConverterParameter=Series}">
                        <RadioButton.ToolTip><TextBlock Text="{Binding SeriesCount, StringFormat='{}{0:N0} series'}" /></RadioButton.ToolTip>
                    </RadioButton>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="18,10" />
                    <RadioButton Style="{StaticResource RailButton}" Tag="&#xE734;" Content="Favorites" GroupName="Nav"
                                 IsChecked="{Binding Tab, Converter={StaticResource EnumEquals}, ConverterParameter=Favorites}">
                        <RadioButton.ToolTip><TextBlock Text="{Binding FavoriteCount, StringFormat='{}{0:N0} favorites'}" /></RadioButton.ToolTip>
                    </RadioButton>
                    <RadioButton Style="{StaticResource RailButton}" Tag="&#xE81C;" Content="Recent" GroupName="Nav"
                                 IsChecked="{Binding Tab, Converter={StaticResource EnumEquals}, ConverterParameter=Recent}">
                        <RadioButton.ToolTip><TextBlock Text="{Binding RecentCount, StringFormat='{}{0:N0} recently watched'}" /></RadioButton.ToolTip>
                    </RadioButton>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,0,0,12">
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Update playlist and TV guide from the provider (F5)"
                            Command="{Binding RefreshCommand}" Foreground="{StaticResource Subtle}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Static local:AppInfo.DisplayVersion}" Foreground="{StaticResource Subtle}" FontSize="10" Opacity="0.7"
                               HorizontalAlignment="Center" Margin="0,6,0,0" ToolTip="{x:Static local:AppInfo.Title}" />
                </StackPanel>
            </DockPanel>

            <!-- Categories -->
            <Grid Grid.Column="1" Background="{StaticResource Panel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="12,16,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Name" ToolTip="Playlist" />
                    <Button x:Name="SourceMenuButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Playlists"
                            Margin="4,0,0,0" Click="SourceMenu_Click" />
                </Grid>
                <TextBlock Grid.Row="1" Margin="14,6,12,0" Foreground="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap"
                           Text="{Binding AccountInfo}" Visibility="{Binding AccountInfo, Converter={StaticResource VisibleWhen}}" />

                <DockPanel Grid.Row="2" Margin="14,18,14,8">
                    <TextBlock Text="{Binding Groups.Count, StringFormat='{}{0:N0}'}" DockPanel.Dock="Right" Foreground="{StaticResource Subtle}" FontSize="11" />
                    <TextBlock Text="{Binding CategoryNoun}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtle}" />
                </DockPanel>
                <TextBox x:Name="CategorySearchBox" Grid.Row="3" Margin="10,0,10,8" Style="{StaticResource SearchBox}" Tag="Filter categories"
                         Text="{Binding CategorySearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ctrl+Shift+F" />

                <ListBox x:Name="GroupList" Grid.Row="4" Margin="6,0" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                         ItemContainerStyle="{StaticResource CategoryItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GroupItem}">
                            <Grid ToolTip="{Binding Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AllIcon" Text="&#xE80F;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center"
                                           Margin="0,0,8,0" Visibility="Collapsed" />
                                <TextBlock Grid.Column="1" Text="{Binding Display}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Style="{StaticResource Badge}" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding CountText}" FontSize="10.5" Foreground="{StaticResource Subtle}" />
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsAll}" Value="True">
                                    <Setter TargetName="AllIcon" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Status -->
                <StackPanel Grid.Row="5" Margin="14,8,14,12">
                    <DockPanel Margin="0,0,0,4" Visibility="{Binding LibraryText, Converter={StaticResource VisibleWhen}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="12" MinWidth="26" MinHeight="26" Padding="4"
                                ToolTip="Update from the provider (F5)" Command="{Binding RefreshCommand}" Foreground="{StaticResource Subtle}" />
                        <TextBlock Text="{Binding LibraryText}" Foreground="{StaticResource Subtle}" FontSize="11" VerticalAlignment="Center"
                                   ToolTip="Channels, movies and series are saved locally and only re-downloaded when you update." />
                    </DockPanel>
                    <ProgressBar IsIndeterminate="True" Height="2" BorderThickness="0" Foreground="{StaticResource Accent}" Background="Transparent"
                                 Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap"
                               Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap"
                               Visibility="{Binding StatusText, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding GuideStatus}" Foreground="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap"
                               Visibility="{Binding GuideStatus, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
            </Grid>

            <!-- Content -->
            <Grid Grid.Column="2" Background="{StaticResource ContentBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="18,16,18,0" LastChildFill="True">
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back (Backspace)"
                            Command="{Binding CloseSeriesCommand}" Margin="-8,0,4,0"
                            Visibility="{Binding OpenSeries, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCountText}" Foreground="{StaticResource Subtle}" FontSize="12"
                               VerticalAlignment="Bottom" Margin="12,0,0,4" />
                    <TextBlock Text="{Binding TabTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>

                <TextBox x:Name="SearchBox" Grid.Row="1" Margin="16,12,16,10" Style="{StaticResource SearchBox}" Tag="{Binding ItemSearchHint}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ctrl+F" />

                <Grid Grid.Row="2">
                    <ListBox x:Name="ChannelList" Margin="10,0,6,0" Padding="0,0,0,8"
                             ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" ItemTemplate="{StaticResource ChannelRow}"
                             MouseDoubleClick="ChannelList_MouseDoubleClick" KeyDown="ChannelList_KeyDown"
                             Visibility="{Binding UsePosterGrid, Converter={StaticResource HiddenWhen}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource CategoryItem}">
                                <Setter Property="Padding" Value="6,2" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <ListBox x:Name="PosterGrid" Margin="8,0,2,0" ItemContainerStyle="{StaticResource PlainItem}" Focusable="False"
                             SizeChanged="PosterGrid_SizeChanged"
                             Visibility="{Binding UsePosterGrid, Converter={StaticResource VisibleWhen}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource PosterCard}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty states -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasSources, Converter={StaticResource HiddenWhen}}">
                        <Image Source="/Assets/logo.png" Width="72" Height="72" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="No playlists yet" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                        <TextBlock Text="Add an Xtream Codes login, an M3U URL, or an M3U file." Foreground="{StaticResource Subtle}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Add playlist" Margin="0,16,0,0" HorizontalAlignment="Center"
                                Command="{Binding AddSourceCommand}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding ShowEmptyList, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="32" HorizontalAlignment="Center" Foreground="{StaticResource Subtle}" />
                        <TextBlock Text="Nothing here" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <GridSplitter x:Name="Splitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource Bg}" />

        <!-- ================= Player + details ================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="DetailsRow" Height="250" />
            </Grid.RowDefinitions>

            <Border Background="Black">
                <vlc:VideoView x:Name="VideoView" Background="Black">
                    <!-- Overlay content is hosted in a transparent window above the video. A near-transparent
                         background keeps it hit-testable so mouse and keyboard reach the controls. -->
                    <Grid x:Name="Overlay" Background="#01000000" Focusable="True"
                          TextElement.FontFamily="{StaticResource UiFont}"
                          MouseMove="Overlay_MouseMove" MouseLeftButtonDown="Overlay_MouseLeftButtonDown" PreviewKeyDown="Window_PreviewKeyDown"
                          MouseWheel="Overlay_MouseWheel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasMedia, Converter={StaticResource HiddenWhen}}">
                            <Image Source="/Assets/logo.png" Width="88" Height="88" Opacity="0.9" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="Pick something to watch" FontFamily="{StaticResource DisplayFont}" FontSize="16" Foreground="#AB9A9E"
                                       Margin="0,14,0,2" HorizontalAlignment="Center" />
                            <TextBlock Text="Double-click a channel or poster" Foreground="#8A7A7E" HorizontalAlignment="Center" />
                        </StackPanel>

                        <Border x:Name="TopBar" Grid.Row="0" Padding="18,12" Visibility="{Binding HasMedia, Converter={StaticResource VisibleWhen}}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#CC000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" Foreground="White" />
                                <Border Background="#33FFFFFF" CornerRadius="4" Padding="6,1" Margin="12,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding VideoInfo, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock Text="{Binding VideoInfo}" Foreground="#F6EDEF" FontSize="11" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#B3000000" CornerRadius="10" Padding="18,12"
                                Visibility="{Binding StatusText, Converter={StaticResource VisibleWhen}}" MaxWidth="520">
                            <TextBlock Text="{Binding StatusText}" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" />
                        </Border>

                        <Border x:Name="ControlBar" Grid.Row="2" Padding="12,22,12,8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#E0000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" Value="{Binding Position}" IsMoveToPointEnabled="True"
                                        Visibility="{Binding IsSeekable, Converter={StaticResource VisibleWhen}}" Margin="4,0,4,4" Focusable="False" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Previous channel (PgUp)" Foreground="White"
                                                Click="ChannelUp_Click" Focusable="False" />
                                        <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Play / pause (Space)" Foreground="White"
                                                Command="{Binding TogglePauseCommand}" Focusable="False" FontSize="18" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="Stop" Foreground="White"
                                                Click="Stop_Click" Focusable="False" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Next channel (PgDn)" Foreground="White"
                                                Click="ChannelDown_Click" Focusable="False" />
                                        <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE767;" ToolTip="Mute (M)" Foreground="White"
                                                Command="{Binding ToggleMuteCommand}" Focusable="False" Margin="8,0,0,0" />
                                        <Slider Width="100" Minimum="0" Maximum="100" Value="{Binding Volume}" VerticalAlignment="Center" Focusable="False"
                                                IsMoveToPointEnabled="True" ToolTip="Volume (↑ / ↓ or mouse wheel)" />
                                        <TextBlock Text="{Binding Volume}" Foreground="#C9B8BC" VerticalAlignment="Center" Margin="6,0,0,0" Width="26" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="White" VerticalAlignment="Center" Margin="12,0" FontSize="12" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE8D6;" ToolTip="Audio track" Foreground="White"
                                                Click="AudioTracks_Click" Focusable="False" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE7F0;" ToolTip="Subtitles" Foreground="White"
                                                Click="Subtitles_Click" Focusable="False" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE799;" ToolTip="Aspect ratio (A)" Foreground="White"
                                                Click="Aspect_Click" Focusable="False" />
                                        <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="Fullscreen (F / double-click)" Foreground="White"
                                                Click="Fullscreen_Click" Focusable="False" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </vlc:VideoView>
            </Border>

            <!-- ================= Details ================= -->
            <Border x:Name="DetailsPanel" Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="20,16,20,14">
                    <!-- Live channel: now / next + schedule -->
                    <Grid Visibility="{Binding DetailIsLive, Converter={StaticResource VisibleWhen}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="52" Height="52" CornerRadius="10" Background="{StaticResource Panel2}" Margin="0,0,14,0">
                                    <Image Source="{Binding DetailItem.LogoUrl, Converter={StaticResource Logo}, ConverterParameter=104}" Margin="5" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DetailItem.Name}" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Border Background="#40E5172A" CornerRadius="4" Padding="6,1" Margin="0,0,8,0">
                                            <TextBlock Text="LIVE" Foreground="#FF8A92" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Text="{Binding DetailItem.Channel.Group}" Foreground="{StaticResource Subtle}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding NowText}" Margin="0,14,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Visibility="{Binding NowText, Converter={StaticResource VisibleWhen}}" />
                            <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding DetailItem.Progress}" Margin="0,6,0,0" Height="3"
                                         Visibility="{Binding DetailItem.Progress, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Text="{Binding NowDescription}" Margin="0,8,0,0" Foreground="{StaticResource Subtle}" TextWrapping="Wrap" MaxHeight="54"
                                       TextTrimming="WordEllipsis" Visibility="{Binding NowDescription, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Text="{Binding NextText}" Margin="0,8,0,0" Foreground="{StaticResource Subtle}" TextWrapping="Wrap"
                                       Visibility="{Binding NextText, Converter={StaticResource VisibleWhen}}" />
                        </StackPanel>

                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="SCHEDULE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Subtle}" Margin="8,0,0,6"
                                       Visibility="{Binding Schedule.Count, Converter={StaticResource VisibleWhen}}" />
                            <ListBox ItemsSource="{Binding Schedule}" Focusable="False">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource CategoryItem}">
                                        <Setter Property="Padding" Value="8,4" />
                                        <Setter Property="Focusable" Value="False" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ProgrammeItem}">
                                        <Grid ToolTip="{Binding Description}" ToolTipService.ShowDuration="60000">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Day}" Foreground="{StaticResource Subtle}" FontSize="12" />
                                            <TextBlock x:Name="TimeText" Grid.Column="1" Text="{Binding Time}" Foreground="{StaticResource Subtle}" FontSize="12" />
                                            <TextBlock x:Name="TitleText" Grid.Column="2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsNow}" Value="True">
                                                <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource AccentLight}" />
                                                <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="TimeText" Property="Foreground" Value="{StaticResource AccentLight}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                <Setter TargetName="TitleText" Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>

                    <!-- Movie / series / episode -->
                    <Grid Visibility="{Binding DetailIsVod, Converter={StaticResource VisibleWhen}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="144" CornerRadius="10" Background="{StaticResource Panel2}" Margin="0,0,20,0">
                            <Grid>
                                <TextBlock Text="{Binding DetailItem.Initial}" FontFamily="{StaticResource DisplayFont}" FontSize="40" Foreground="#4A3438"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border CornerRadius="10">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding DetailItem.LogoUrl, Converter={StaticResource Logo}, ConverterParameter=440}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <DockPanel Grid.Column="1">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="{Binding DetailItem.Name}" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"
                                           TextWrapping="Wrap" MaxHeight="58" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Style="{StaticResource Badge}" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding DetailItem.KindLabel}" FontSize="11" />
                                    </Border>
                                    <Border Style="{StaticResource Badge}" Margin="0,0,8,0" Visibility="{Binding DetailItem.RatingText, Converter={StaticResource VisibleWhen}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DetailItem.RatingText}" FontSize="11" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding DetailItem.Channel.Group}" Foreground="{StaticResource Subtle}" FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="DetailPlayButton" Style="{StaticResource PrimaryButton}" Padding="16,7"
                                        Command="{Binding OpenCommand}" CommandParameter="{Binding DetailItem}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE768;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DetailItem.IsSeries}" Value="True">
                                                            <Setter Property="Text" Value="&#xE8A9;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Play" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DetailItem.IsSeries}" Value="True">
                                                            <Setter Property="Text" Value="Browse episodes" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button Margin="8,0,0,0" Padding="12,7" Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding DetailItem}"
                                        Visibility="{Binding DetailItem.CanFavorite, Converter={StaticResource VisibleWhen}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE734;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DetailItem.IsFavorite}" Value="True">
                                                            <Setter Property="Text" Value="&#xE735;" />
                                                            <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Favorite" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding NowDescription}" Margin="0,12,0,0" Foreground="{StaticResource Subtle}" TextWrapping="Wrap"
                                       TextTrimming="WordEllipsis" LineHeight="19" />
                        </DockPanel>
                    </Grid>

                    <TextBlock Text="Select a channel or title to see details" Foreground="{StaticResource Subtle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding DetailItem, Converter={StaticResource HiddenWhen}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
